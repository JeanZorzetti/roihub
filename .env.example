# Basic Auth do hub.
HUB_USER=roi
HUB_PASS=

# Autopublishing. Mantenha os valores vazios neste arquivo e configure-os no ambiente.
# Uma ou mais contas separadas por vírgula, cada uma de `claude setup-token`
# (assinatura, sem API paga). Conta esgotada ou sem acesso é pulada automaticamente.
CLAUDE_CODE_OAUTH_TOKENS=
CRON_SECRET=
# Ingestão de leads da Orion em POST /api/crm/leads. Segredo PRÓPRIO de
# propósito: com o CRON_SECRET, quem publica artigo também gravaria lead.
CRM_INGEST_SECRET=
DATABASE_URL=
GITHUB_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
UNSPLASH_ACCESS_KEY=

# Opcional: caminho do binário claude quando não estiver no PATH.
CLAUDE_BIN=

# Ollama para a aba /busca. Em producao: http://sofia_ollama:11434 (rede interna do EasyPanel).
# Sem ela a busca cai para BM25 - degrada, nao quebra.
OLLAMA_URL=

# Conta do Mercado Pago do atma. Sem ela, scripts/vendas-mercadopago.mjs falha FECHADO.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
