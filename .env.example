# Basic auth do hub (obrigatório em produção — sem HUB_PASS o app responde 503)
HUB_USER=roi
HUB_PASS=

# JSON da service account do Google em UMA linha.
# REUSAR a service account existente (já tem acesso às 4 propriedades nimblabs):
#   nimblabs@review-dispute-agent-498311.iam.gserviceaccount.com
#   chave: nimblabs/docs/review-dispute-agent-498311-*.json (copiar o conteúdo pra cá)
# Pra cobrir os outros projetos, adicionar esse e-mail em cada propriedade do
# Search Console: Configurações → Usuários e permissões → Adicionar ("Restrito" basta).
# O hub descobre as propriedades sozinho (sites.list, cache 10 min) — sem config por projeto.
# Sem essa env o hub funciona normal usando o seoSeed manual do projects.json.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Postgres da aba Agenda (tabelas hub_tasks/hub_done, criadas sozinhas no 1º uso).
# Banco DEDICADO roihub_db (externo 2.24.207.200:5445); sem essa env a /agenda fica em modo leitura.
DATABASE_URL=
