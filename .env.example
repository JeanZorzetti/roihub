# Basic Auth do hub.
HUB_USER=roi
HUB_PASS=

# Autopublishing. Mantenha os valores vazios neste arquivo e configure-os no ambiente.
# CLAUDE_CODE_OAUTH_TOKEN vem de `claude setup-token` (assinatura, sem API paga).
CLAUDE_CODE_OAUTH_TOKEN=
CRON_SECRET=
DATABASE_URL=
GITHUB_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
UNSPLASH_ACCESS_KEY=

# Opcional: caminho do binário claude quando não estiver no PATH.
CLAUDE_BIN=
