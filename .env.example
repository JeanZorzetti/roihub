# Basic auth do hub (obrigatório em produção — sem HUB_PASS o app responde 503)
HUB_USER=roi
HUB_PASS=

# JSON da service account do Google em UMA linha.
# Setup (uma vez só):
#   1. console.cloud.google.com → criar projeto → ativar "Google Search Console API"
#   2. IAM → Service Accounts → criar → gerar chave JSON
#   3. Em CADA propriedade do Search Console: Configurações → Usuários → adicionar
#      o e-mail da service account com permissão "Restrito"
# Sem essa env o hub funciona normal usando o seoSeed manual do projects.json.
GOOGLE_SERVICE_ACCOUNT_JSON=
